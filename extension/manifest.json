{
  "manifest_version": 3,
  "name": "AIR web-chat review",
  "version": "0.2.14",
  "description": "Review a PDF in a chat you are already signed into. Click the icon, pick a file, and click Review my paper.",
  "action": {
    "default_title": "Review a paper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "review.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "build/background.js"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*",
    "https://morgansmart-alt.github.io/*",
    "https://zenodo.org/*",
    "https://doi.org/*",
    "https://arxiv.org/*",
    "https://export.arxiv.org/*",
    "https://lotswxboafsenmszijpf.supabase.co/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://copilot.microsoft.com/*",
    "https://www.perplexity.ai/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://localhost/*",
      "https://127.0.0.1/*",
      "https://morgansmart-alt.github.io/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "https://morgansmart-alt.github.io/*"
      ],
      "js": ["build/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "http://127.0.0.1:*/e2e/mock-chat.html*",
        "http://localhost:*/e2e/mock-chat.html*"
      ],
      "js": ["build/runner.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "air-web-chat@open-ai-peer-review.local",
      "strict_min_version": "128.0"
    }
  }
}
